DB_HOST=localhost
DB_PORT=5432
DB_NAME=piscicultura
DB_USER=
DB_PASSWORD=

ML_DATASETS_DIR=C:/Users/rafael/Desktop/TCC/datasets
# altitude do tanque em metros (São Paulo: ~760 m)
ML_ALTITUDE_M=760

# Aerador automático: liga com o OD estimado ou projetado para 1 h abaixo de LIGA_OD e
# desliga (só o que ele mesmo ligou) com o OD acima de DESLIGA_OD. Usa o mesmo broker da ingestão.
ML_AERADOR_AUTOMATICO=false
ML_AERADOR_LIGA_OD=4.0
ML_AERADOR_DESLIGA_OD=5.0
ML_AERADOR_PAUSA_MANUAL_MIN=30
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=tcc-piscicultura-morgado
