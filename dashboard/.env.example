# Usa dados simulados (MSW) no lugar da API real. Coloque "false" quando o backend estiver disponível.
VITE_USAR_MOCKS=true

# Caminho da API vista pelo navegador. Mantenha relativo para usar o proxy (mesma origem).
VITE_API_URL=/api/v1

# Somente desenvolvimento: endereço do backend FastAPI para onde o Vite repassa /api.
# Exemplo: API_PROXY_ALVO=http://localhost:8000
API_PROXY_ALVO=
